<?xml version="1.0"?>
<!--
    This file is part of ALPHA AUV project.
    The localization setup use navsat_transform to anchor vehicle's odom frame to a specific gps location.
    The odometry local will then be generated by fusing 
        -IMU data (transformed into ENU)
        -DVL data
        -GPS odometry (converted by the navsat_transform)

    When the AUV is resurfaced after a diving, new gps fixes will impact the vehicle position. Small jump will be visible.

    Author: Mingxi Zhou
    Email: mzhou@uri.edu
    Year: 2022

    Copyright (C) 2022 Smart Ocean Systems Laboratory

-->
<launch>

    <arg name="robot_name" default="wamv"/>

    <arg name="is_sim" default="false"/>

    <node ns="$(arg robot_name)" name="wamv_localization_local" pkg="robot_localization" type="ekf_localization_node" output="screen">
        <rosparam command="load" file="$(find wamv_config)/config/robot_localization_local.yaml"/>

        <param name="base_link_frame" type="string" value="$(arg robot_name)/base_link"/>
        <param name="odom_frame" type="string" value="$(arg robot_name)/odom"/>
        <param name="world_frame" type="string" value="$(arg robot_name)/odom"/>
        <param name="map_frame" type="string" value="$(arg robot_name)/map"/>

        <remap from="odometry/filtered" to="odometry/filtered/local"/>
        <remap from="accel/filtered" to="accel/filtered/local"/>


        <param name="imu0" value="imu/data"/>
        <rosparam param="imu0_config">
            [false, false, false,
               true, true, true,
               false, false, false,
               true, true, false,
               true, true, true]
        </rosparam>
        <param name="imu0_nodelay" value="true"/>
        <param name="imu0_differential" value="false"/>
        <param name="imu0_relative" value="false"/>
        <param name="imu0_queue_size" value="100"/>
        <param name="imu0_remove_gravitational_acceleration" value="false"/>

        <param name="twist0" value="dvl/twist"/>
        <rosparam param="twist0_config">
        [false, false, false,
         false, false, false,
         true,   true, true,
         false, false, false,
         false, false, false]
        </rosparam>
        <param name="twist0_nodelay" value="true"/>
        <param name="twist0_relative" value="false"/>
        <param name="twist0_queue_size" value="20"/>

        <!-- <param name="pose0" value="depth_filtered"/>
        <rosparam param="pose0_config">
        [false, false,  true,
         false, false, false,
         false, false, false,
         false, false, false,
         false, false, false]
        </rosparam>
        <param name="pose0_differential" value="false"/>
        <param name="pose0_relative" value="false"/>
        <param name="pose0_queue_size" value="10"/>
        <param name="pose0_nodelay" value="true"/> -->

        <param name="odom0" value="gps/odometry"/>
        <rosparam param="odom0_config">
         [true, true, true,
        false, false, false,
        false, false, false,
        false, false, false,
        false, false, false]
        </rosparam>
        <param name="odom0_queue_size" value="10"/>
        <param name="odom0_nodelay" value="true"/>
        <param name="odom0_differential" value="false"/>
        <param name="odom0_relative" value="false"/>


    </node>

    <group if="$(arg is_sim)">

        <node ns="$(arg robot_name)" name="wamv_imu_ned_to_enu" pkg="mvp_localization_utilities" type="imu_ned_to_enu" output="screen">
            <remap from="imu_in/data" to="imu/stonefish/data"/>
            <remap from="imu_out/data" to="imu/data"/>
            <param name="frame_id" value="$(arg robot_name)/imu_sf"/>

            <param name="roll_offset" value="3.1415926"/>
            <param name="pitch_offset" value="0.0"/>
            <param name="yaw_offset" value="1.5707"/>

            <param name="roll_reverse" value="1"/>
            <param name="pitch_reverse" value="-1"/>
            <param name="yaw_reverse" value="-1"/>
        </node>

        <!-- <node ns="$(arg robot_name)" name="pressure_to_depth" pkg="alpha_localization" type="pressure_to_depth_node" output="screen">
            <param name="frame_id" value="$(arg robot_name)/pressure"/>

            <remap from="depth" to="depth"/>
            <remap from="pressure" to="pressure"/>
        </node> -->

    </group>

    <node ns="$(arg robot_name)" pkg="mvp_localization_utilities" type="world_odom_transform_node" name="world_odom_transform_node" output="screen">
        <param name = "tf_prefix" value="$(arg robot_name)"/>
        <param name = "mag_declination" value="0.0" />
        <param name = "mag_declination_auto" value="false" />
        <param name = "acceptable_var" value = "5" />
        <param name = "m_gps_wait_time" value ="5"/>
        <param name = "datum_latitude" value="41.0"/>
        <param name = "datum_longitude" value="-71.0"/>
        <param name = "position_accuracy" value="3.0"/>
        <param name = "mag_model_path" value = "$(find mvp_localization_utilities)/config/magnetic"/>
        <remap from = "odometry" to ="odometry/filtered/local" />
    </node>

    <!-- <node ns="$(arg robot_name)" name="depth_filter" pkg="alpha_localization" type="depth_filter_node" output="screen">
        <param name="frame_id" value="$(arg robot_name)/odom"/>

        <remap from="depth" to="depth"/>
        <remap from="depth_filtered" to="depth_filtered"/>
    </node> -->



</launch>